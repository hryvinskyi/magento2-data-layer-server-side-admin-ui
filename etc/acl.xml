<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Hryvinskyi_DataLayerAdminUi::config">
                                <!-- Queue failed events again and send a test event; the status itself needs only
                                     the settings' rule -->
                                <resource id="Hryvinskyi_DataLayerServerSideAdminUi::delivery"
                                          title="Server-side delivery actions" translate="title"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
