{
    "name": "@hryvinskyi/datalayer-setup-server",
    "description": "Sources of the setup wizard's server-side step, a plugin of the GA4 data layer setup wizard, built into view/adminhtml/web/js/setup/server-step.js.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.15"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "check": "tsc --noEmit -p tsconfig.json",
        "test": "TSX_TSCONFIG_PATH=test/tsconfig.run.json node --import tsx --import ./test/resolve-shared.mjs --import ./test/setup-dom.ts --test 'src/**/*.test.{ts,tsx}'",
        "verify-build": "node scripts/verify-build.mjs"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.14.5",
        "@testing-library/preact": "3.2.4",
        "@types/node": "26.6.3",
        "esbuild": "0.28.2",
        "happy-dom": "20.14.5",
        "preact": "10.29.8",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
